/*
============================================================================
Product Analytical Report
============================================================================
Purpose:
    This analytical report consolidates key product performance metrics, 
    sales behaviors, and inventory-to-revenue tracking indicators.
    
Highlights:
    1. Gathers essential product attributes including name, category, 
       subcategory, and base cost.
    2. Segments products by revenue thresholds to dynamically identify 
       High-Performers, Mid-Range, and Low-Performers.
    3. Aggregates product-level operational metrics:
        - total orders (frequency)
        - total sales revenue (monetary)
        - total quantity sold
        - total unique customers reached
        - product active lifespan (in months)
    4. Calculates valuable business KPIs:
        - recency (months since last order)
        - average order revenue (AOR)
        - average monthly revenue
        - average actual selling price
============================================================================
*/

CREATE OR REPLACE VIEW gold_report_products AS
WITH base_query_products AS (
    -- 1) Base Query: Retrieves core columns from tables
    SELECT
        f.order_number,
        f.product_key,      
        f.order_date,
        f.sales_amount,
        f.quantity,
        f.customer_key,     
        p.product_number,   
        p.product_name,
        p.category,
        p.subcategory,
        p.cost
    FROM gold_dta_fact_sales f
    LEFT JOIN gold_dta_dim_products p
        ON f.product_key = p.product_key
    WHERE f.order_date IS NOT NULL 
      AND f.order_date > '0001-01-01' 
),
product_aggregation AS (
    -- 2) Product Aggregations: Summarizes key metrics at the product level
    SELECT
        product_key,
        product_number,
        product_name,       
        category,
        subcategory,
        cost,
        PERIOD_DIFF(
            CAST(DATE_FORMAT(MAX(order_date), '%Y%m') AS UNSIGNED), 
            CAST(DATE_FORMAT(MIN(order_date), '%Y%m') AS UNSIGNED)
        ) AS lifespan,
        MAX(order_date) AS last_sales_date,
        COUNT(DISTINCT order_number) AS total_orders,
        COUNT(DISTINCT customer_key) AS total_customers,
        SUM(sales_amount) AS total_sales,
        SUM(quantity) AS total_quantity,
        ROUND(AVG(CAST(sales_amount AS DECIMAL(10,2)) / NULLIF(quantity, 0)), 1) AS avg_selling_price
    FROM base_query_products 
    GROUP BY
        product_key,
        product_number,
        product_name,
        category,
        subcategory,
        cost
)
-- 3) Final Select: Combines aggregated metrics and computes business indicators
SELECT
    product_key,
    product_number,
    product_name,
    category,
    subcategory,
    cost,
    last_sales_date,
    TIMESTAMPDIFF(MONTH, last_sales_date, NOW()) AS recency_in_months,
    CASE 
        WHEN total_sales > 50000 THEN 'High-Performer'
        WHEN total_sales > 10000 THEN 'Mid-Performer'
        ELSE 'Low-Performer'
    END AS product_segment,
    lifespan,
    total_orders,
    total_sales,
    total_quantity,
    total_customers,
    avg_selling_price,
    -- Average Order Revenue (AOR)
    CASE 
        WHEN total_orders = 0 THEN 0
        ELSE ROUND(total_sales / total_orders, 0)
    END AS avg_order_revenue,
    -- Average Monthly Revenue
    CASE 
        WHEN lifespan = 0 THEN total_sales
        ELSE ROUND(total_sales / lifespan, 0)
    END AS avg_monthly_revenue
FROM product_aggregation;
